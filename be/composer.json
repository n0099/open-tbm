{
    "type": "project",
    "name": "n0099/open-tbm",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "8.4.*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "beberlei/doctrineextensions": "dev-master",
        "doctrine/doctrine-bundle": "^2.18.2",
        "doctrine/orm": "^3.6.2",
        "google/protobuf": "^4.33.6",
        "illuminate/collections": "^12.56",
        "spatie/laravel-collection-macros": "^8.1.0",
        "spatie/regex": "^3.1.1",
        "symfony/dotenv": "^7.4.8",
        "symfony/flex": "^2.10.0",
        "symfony/framework-bundle": "^7.4.8",
        "symfony/monolog-bundle": "^3.11.1",
        "symfony/property-access": "^7.4.8",
        "symfony/runtime": "^7.4.8",
        "symfony/serializer": "^7.4.8",
        "symfony/stopwatch": "^7.4.8",
        "symfony/twig-bundle": "^7.4.8",
        "symfony/validator": "^7.4.8",
        "symfony/yaml": "^7.4.8",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6.0",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.94.2",
        "infection/infection": "^0.30.3",
        "phan/phan": "^5.5.2",
        "phpmd/phpmd": "^2.15.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-strict-rules": "^2.0.10",
        "phpstan/phpstan-symfony": "^2.0.15",
        "phpunit/phpunit": "^12.5.15",
        "psalm/plugin-symfony": "^5.3.0",
        "roave/security-advisories": "dev-latest",
        "spatie/symfony-ignition-bundle": "^1.3.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "symfony/debug-bundle": "^7.4.8",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/phpunit-bridge": "^7.4.8",
        "symfony/web-profiler-bundle": "^7.4.8",
        "thecodingmachine/phpstan-safe-rule": "^1.4.3"
    },
    "repositories": [
        {
            "url": "https://github.com/n0099/DoctrineExtensions",
            "type": "git"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "bump-after-update": true
    },
    "autoload": {
        "classmap": ["config/"],
        "psr-4": {
            "App\\": "src/",
            "TbClient\\": "../tbclient.protobuf/tbm_php/TbClient/",
            "GPBMetadata\\": "../tbclient.protobuf/tbm_php/GPBMetadata/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.*"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts",
            "cd public/react-json-view && [ -f dist/index.js ] || (yarn && yarn vite build)"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
