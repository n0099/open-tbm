{ // https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "lockFileMaintenance": { "enabled": true },
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchCategories": ["ci"],
      "addLabels": ["CI"]
    },
    {
      "matchCategories": ["dotnet"],
      "addLabels": ["nuget"]
    },
    {
      "matchCategories": ["php"],
      "addLabels": ["composer"]
    },
    {
      "matchCategories": ["js"],
      "addLabels": ["yarn"]
    },
    {
      "matchFileNames": [".github/actions/**", ".github/workflows/**"],
      "groupName": "CI",
      "commitMessagePrefix": "deps(CI): "
    },
    {
      "matchFileNames": ["c#/**"],
      "groupName": "c#",
      "commitMessagePrefix": "deps(c#): "
    },
    {
      "matchFileNames": ["be/**"],
      "groupName": "be",
      "commitMessagePrefix": "deps(be): "
    },
    {
      "matchFileNames": ["be/public/react-json-view/**"],
      "groupName": "react-json-view",
      "commitMessagePrefix": "deps(react-json-view): "
    },
    {
      "matchFileNames": ["fe/**"],
      "groupName": "fe",
      "commitMessagePrefix": "deps(fe): "
    },
    { // https://github.com/renovatebot/renovate/discussions/27906
      "matchCategories": ["php"],
      "matchDepNames": ["php"],
      "enabled": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": ["be/public/react-json-view/**"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      // https://github.com/renovatebot/config-help/issues/89
      // https://github.com/renovatebot/renovate/discussions/15899
      "branchTopic": "lock-file-maintenance/{{{groupSlug}}}",
      "branchNameStrict": false
    }
  ]
}
