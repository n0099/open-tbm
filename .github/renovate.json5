{ // https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "lockFileMaintenance": { "enabled": true },
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchCategories": ["ci"],
      "addLabels": ["CI"]
    },
    {
      "matchCategories": ["dotnet"],
      "addLabels": ["nuget"]
    },
    {
      "matchCategories": ["php"],
      "addLabels": ["composer"]
    },
    {
      "matchCategories": ["js"],
      "addLabels": ["yarn"]
    },
    {
      "matchFileNames": [".github/actions/**", ".github/workflows/**"],
      "groupName": "CI",
      "commitMessagePrefix": "deps(CI): "
    },
    {
      "matchFileNames": ["c#/**"],
      "groupName": "c#",
      "commitMessagePrefix": "deps(c#): "
    },
    {
      "matchFileNames": ["be/**"],
      "groupName": "be",
      "commitMessagePrefix": "deps(be): "
    },
    {
      "matchFileNames": ["be/public/react-json-view/**"],
      "groupName": "react-json-view",
      "commitMessagePrefix": "deps(react-json-view): "
    },
    {
      "matchFileNames": ["fe/**"],
      "groupName": "fe",
      "commitMessagePrefix": "deps(fe): "
    },
    {
      "matchCategories": ["php"],
      // https://github.com/renovatebot/renovate/discussions/27906#discussioncomment-15052440
      // https://www.jvt.me/posts/2025/05/21/renovate-depname-packagename/
      "matchDepNames": ["php"],
      "enabled": false
    },
    {
      // https://docs.renovatebot.com/language-constraints-and-upgrading/
      // https://docs.renovatebot.com/configuration-options/#constraintsfiltering
      // https://stackoverflow.com/questions/75507822/how-to-prevent-renovate-from-updating-dependencies-which-are-not-compatible-with
      "matchCategories": ["dotnet"],
      "matchDepNames": [
        "dotnet-sdk",
        "Microsoft.EntityFrameworkCore",
        "EFCore.NamingConventions",
        "Npgsql.EntityFrameworkCore.PostgreSQL",
        "Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite",
        "LinqKit.Microsoft.EntityFrameworkCore",
        "linq2db.EntityFrameworkCore"
      ],
      "separateMajorMinor": true
    }
  ]
}
