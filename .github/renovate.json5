{ // https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "separateMajorMinor": false,
  "lockFileMaintenance": {
    "enabled": true,
    // https://github.com/renovatebot/config-help/issues/89
    // https://github.com/renovatebot/renovate/discussions/15899
    "branchTopic": "lock-file-maintenance/{{groupSlug}}"
  },
  "commitMessagePrefix": "deps({{{groupName}}}): ",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchCategories": ["ci"],
      "addLabels": ["CI"]
    },
    {
      "matchCategories": ["dotnet"],
      "addLabels": ["nuget"]
    },
    {
      "matchCategories": ["php"],
      "addLabels": ["composer"]
    },
    {
      "matchCategories": ["js"],
      "addLabels": ["yarn"]
    },
    {
      "matchFileNames": [".github/actions/**", ".github/workflows/**"],
      "groupName": "CI"
    },
    {
      "matchFileNames": ["c#/**"],
      "groupName": "c#"
    },
    {
      "matchFileNames": ["be/**"],
      "groupName": "be"
    },
    {
      "matchFileNames": ["be/public/react-json-view/**"],
      "groupName": "be/public/react-json-view"
    },
    {
      "matchFileNames": ["fe/**"],
      "groupName": "fe"
    },
    { // https://github.com/renovatebot/renovate/discussions/27906
      "matchCategories": ["php"],
      "matchDepNames": ["php"],
      "enabled": false,
      "dependencyDashboardApproval": true
    }
  ]
}
